# OpenAI
OPENAI_API_KEY=
RAG_OPENAI_MAX_ATTEMPTS=3

# Document source
CS_NOTES_ROOT=.
CS_NOTES_REFRESH_INTERVAL_MS=2000

# PostgreSQL / pgvector
RAG_PERSISTENCE_ENABLED=true
RAG_DATABASE_URL=jdbc:postgresql://localhost:5432/cs_notes
RAG_DATABASE_USERNAME=cs_notes
RAG_DATABASE_PASSWORD=cs_notes

# Embedding and indexing
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_BATCH_SIZE=64
RAG_INDEXING_ENABLED=true
RAG_CHUNK_MAX_CHARACTERS=2000
RAG_INDEXING_MAX_DOCUMENTS=200
RAG_INDEXING_MAX_CHUNKS_PER_DOCUMENT=200
RAG_INDEXING_MAX_CHARACTERS_PER_RUN=500000

# Dense, Sparse and Hybrid search
RAG_SEARCH_ENABLED=true
RAG_SEARCH_DEFAULT_LIMIT=5
RAG_SEARCH_MAX_LIMIT=20
RAG_SEARCH_MAX_QUERY_CHARACTERS=500
RAG_SEARCH_DEFAULT_MINIMUM_SCORE=0.5
RAG_SEARCH_SPARSE_DEFAULT_MINIMUM_SCORE=0.0
RAG_SEARCH_HYBRID_CANDIDATE_LIMIT=20
RAG_SEARCH_HYBRID_RRF_K=60
RAG_RERANKING_ENABLED=false
RAG_RERANKING_MINIMUM_SCORE=0.0
RAG_SEARCH_QUERY_CACHE_TTL=10m
RAG_SEARCH_QUERY_CACHE_MAX_ENTRIES=100

# Retrieval evaluation
RAG_EVALUATION_ENABLED=true
RAG_EVALUATION_RESULT_LIMIT=10

# RAG answer generation and cost guard
RAG_ANSWER_ENABLED=true
RAG_ANSWER_MODEL=gpt-4.1-mini
RAG_ANSWER_MAX_OUTPUT_TOKENS=600
RAG_ANSWER_TEMPERATURE=0.2
RAG_ANSWER_DEFAULT_SOURCE_LIMIT=4
RAG_ANSWER_MAX_SOURCE_LIMIT=6
RAG_ANSWER_MAX_CONTEXT_CHARACTERS=12000
RAG_ANSWER_DEFAULT_MINIMUM_SCORE=0.3
RAG_ANSWER_CACHE_TTL=10m
RAG_ANSWER_CACHE_MAX_ENTRIES=100
RAG_ANSWER_INPUT_PRICE_PER_MILLION_USD=0.40
RAG_ANSWER_OUTPUT_PRICE_PER_MILLION_USD=1.60
RAG_ANSWER_DAILY_COST_LIMIT_USD=0.25
RAG_ANSWER_BUDGET_ZONE_ID=Asia/Seoul
